import requests

# သင်၏ Telegram Bot နှင့် Ruijie Portal အချက်အလက်များ
TELEGRAM_BOT_TOKEN = "9137803689:AAGYQD_F7IfK2Q6KKptNU3UWW7DpCA65RL4"
CHAT_ID = "6130147402" 
PORTAL_URL = "http://YOUR_PORTAL_URL_HERE/portal"  # 👈 ဤနေရာတွင် သင်စကန်ဖတ်မည့် Portal URL အမှန်ကို ထည့်ပါ

def send_telegram_msg(text):
    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = {"chat_id": CHAT_ID, "text": text, "parse_mode": "HTML"}
    try:
        requests.post(url, json=payload, timeout=5)
    except:
        pass

# Bot မှတစ်ဆင့် Portal သို့ စမ်းသပ်မည့် ပုံစံ
def test_voucher_via_bot(voucher_code):
    try:
        response = requests.post(
            PORTAL_URL,
            data={"voucher": voucher_code, "login": "submit"},
            timeout=4
        )
        return response.text
    except Exception as e:
        return str(e)
